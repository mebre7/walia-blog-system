SECRET_KEY=your-secret-key
DEBUG=True

# Local PostgreSQL (used when DATABASE_URL is not set)
DB_NAME=walia_blog
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Vercel Postgres / Neon sets this automatically when linked to the project
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional overrides for production (comma-separated, no https://)
# Only needed for extra hostnames; Vercel auto-registers VERCEL_* URLs in settings.py
# ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,extra.example.com
# CSRF_TRUSTED_ORIGINS=https://extra.example.com,https://www.extra.example.com
# SECURE_SSL_REDIRECT=False
